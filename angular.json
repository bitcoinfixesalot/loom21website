{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "loom21website": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale":{ 
          "code":"en"
        },
        "locales": {
          "bg": { "translation": "src/locale/messages.bg.xlf", 
          "subPath": "bg" }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/loom21website",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "prismjs/themes/prism-okaidia.css",
              "katex/dist/katex.min.css",
              "prismjs/plugins/line-numbers/prism-line-numbers.css",
              "prismjs/plugins/line-highlight/prism-line-highlight.css",
              "src/styles.scss",
              "src/assets/scss/style.scss"
            ],
            "scripts": [
              "emoji-toolkit/lib/js/joypixels.min.js",
              "prismjs/prism.js",

              "prismjs/components/prism-bash.min.js",
              "prismjs/components/prism-diff.min.js",
              "prismjs/components/prism-javascript.min.js",
              "prismjs/components/prism-typescript.min.js",
              "emoji-toolkit/lib/js/joypixels.js",
              "katex/dist/katex.min.js",
              "katex/dist/contrib/auto-render.min.js"
            ],
            "server": "src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "server.ts"
            },
            "localize": true,
            "i18nMissingTranslation": "warning",
            "i18nDuplicateTranslation": "warning"
            

          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "namedChunks": false,
              "extractLicenses": true,
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ]              
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": [
                "en"
              ],
              "baseHref": "/en/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "loom21website:build:production"
            },
            "development": {
              "buildTarget": "loom21website:build:development"
            },
            "bg": {
              "buildTarget": "loom21website:build:bg"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "loom21website:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
  "analytics": false
},
"schematics": {
  "@schematics/angular:component": {
    "type": "component"
  },
  "@schematics/angular:directive": {
    "type": "directive"
  },
  "@schematics/angular:service": {
    "type": "service"
  },
  "@schematics/angular:guard": {
    "typeSeparator": "."
  },
  "@schematics/angular:interceptor": {
    "typeSeparator": "."
  },
  "@schematics/angular:module": {
    "typeSeparator": "."
  },
  "@schematics/angular:pipe": {
    "typeSeparator": "."
  },
  "@schematics/angular:resolver": {
    "typeSeparator": "."
  }
}
}
